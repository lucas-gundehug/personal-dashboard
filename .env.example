# Copy this file to .env.local and fill in the values you need.
# README.md → Environment Variables explains each one.

# Required: the 4-digit login code for the start page. There is no default;
# without it every code is refused.
DASHBOARD_ACCESS_CODE=

# Optional but recommended: a long random string mixed into the key that signs
# the login token, so the token isn't protected only by the 4-digit code's
# 10,000 possible values. Generate one with `openssl rand -hex 32`.
AUTH_TOKEN_SECRET=

# Your Outlook calendar's published ICS feed URL.
# Outlook Web → Settings → Calendar → Shared calendars → Publish.
OUTLOOK_ICS_URL=

# From an app created at https://developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# One-time setup: visit /api/public/spotify-login (needs the two above),
# approve on Spotify's page, and copy the token from /api/public/spotify-callback.
SPOTIFY_REFRESH_TOKEN=

# Set automatically when you connect an Upstash Redis database through
# Vercel's Storage tab (or use UPSTASH_REDIS_REST_URL/_TOKEN when connecting to
# Upstash directly). Used by the login rate limit, the games' high scores and
# the calculator history; without them all three fall back to memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: a shared secret that lets the companion housekeeping app
# (https://github.com/lucas-gundehug/housekeeping) change the login code via
# /api/admin/change-code with an X-Housekeeping-Secret header. Give it its own
# long random value. See src/lib/admin-auth-service.ts.
HOUSEKEEPING_SERVICE_SECRET=

# Your Supabase project's API URL and service-role key (Project Settings →
# API) — NEVER the anon/publishable key, since this is used server-side only.
# Powers the workout plan's history and progression (src/lib/workout-store.ts);
# run supabase/schema.sql once first. Without them the plan lives in memory.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
